# Copy this file to .env.local and fill in the values.
# .env.local is gitignored, so never commit real secrets.

# PostgreSQL connection string (use Neon's POOLED connection string, the one
# whose host contains "-pooler"). Example:
# postgres://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/wardrobe?sslmode=require
DATABASE_URL=

# Vercel Blob read/write token for photo uploads (added when we provision Blob).
BLOB_READ_WRITE_TOKEN=

# Google Gemini API key for AI-assisted import (Phase 1.5), free tier.
# Get one (no card needed) at https://aistudio.google.com → "Get API key".
GEMINI_API_KEY=

# --- Authentication (Auth.js / NextAuth v5): single-owner Google login (#119) ---
# Session-signing secret. Generate: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Google OAuth client (Google Cloud Console → Clients → Create OAuth client → Web).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Owner email(s) permitted to sign in, comma-separated. Everyone else is rejected.
OWNER_EMAIL=

# --- Demo mode (LOCAL DEMOS ONLY) ---
# Set to 1 to switch sign-in off: every request acts as an invented "Demo"
# owner, and every page shows a demo banner. Pair it with `pnpm db:seed-demo`
# for an invented catalogue. Never set it on a deployment holding real data.
DEMO_MODE=
